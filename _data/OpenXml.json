{"Data":{"Sdk":{"Events":[{"Id":"12425092452","Type":"IssuesEvent","CreatedAt":"2026-07-28T16:11:26","Actor":"mikeebowen","Repository":"dotnet/Open-XML-SDK","Organization":"dotnet","RawContent":null,"RelatedAction":"closed","RelatedUrl":"https://github.com/dotnet/Open-XML-SDK/issues/2120","RelatedDescription":"Closed issue \"New project: OOXML Behavioral Intelligence — behavioral spec research\" (#2120) at dotnet/Open-XML-SDK","RelatedBody":"Hi Open XML SDK team,\n\nI am launching an open research initiative to document real-world OOXML behavior — the gap between the ECMA/ISO specification and what Office actually does. The project covers differential testing, compatibility case databases, and future AI-assisted discovery.\n\nAs the technical authority on OOXML, your guidance would be invaluable — even just pointing us at known edge cases or undocumented behaviors worth documenting.\n\nRepo: https://github.com/nessim-liamani/ooxml-behavioral-intelligence\n\nOpen to feedback or a brief discussion."},{"Id":"12216072422","Type":"PullRequestEvent","CreatedAt":"2026-07-23T20:02:55","Actor":"dependabot[bot]","Repository":"dotnet/Open-XML-SDK","Organization":"dotnet","RawContent":null,"RelatedAction":"labeled","RelatedUrl":null,"RelatedDescription":null,"RelatedBody":null},{"Id":"12216071798","Type":"PullRequestEvent","CreatedAt":"2026-07-23T20:02:54","Actor":"dependabot[bot]","Repository":"dotnet/Open-XML-SDK","Organization":"dotnet","RawContent":null,"RelatedAction":"labeled","RelatedUrl":null,"RelatedDescription":null,"RelatedBody":null},{"Id":"12216071695","Type":"PullRequestEvent","CreatedAt":"2026-07-23T20:02:54","Actor":"dependabot[bot]","Repository":"dotnet/Open-XML-SDK","Organization":"dotnet","RawContent":null,"RelatedAction":"labeled","RelatedUrl":null,"RelatedDescription":null,"RelatedBody":null},{"Id":"12216071486","Type":"PullRequestEvent","CreatedAt":"2026-07-23T20:02:54","Actor":"dependabot[bot]","Repository":"dotnet/Open-XML-SDK","Organization":"dotnet","R